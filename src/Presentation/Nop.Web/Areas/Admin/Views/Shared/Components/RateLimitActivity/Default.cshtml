@model RateLimitActivityModel

<div class="card card-primary card-outline" id="nopcommerce-rate-limit-activity-card">
    <div class="card-header with-border clearfix">
        <h3 class="card-title">
            <i class="fas fa-shield-alt"></i>
            @T("Admin.Dashboard.RateLimitActivity")
            <a asp-controller="Log" asp-action="List" asp-all-route-data="@Model.LogLink.RouteValues()" class="btn btn-xs btn-info btn-flat margin-l-10">
                @T("Admin.Dashboard.RateLimitActivity.ViewLog")
            </a>
        </h3>
    </div>
    <div class="card-body">
        @if (Model.EpisodeCount == 0)
        {
            <p class="text-muted">@T("Admin.Dashboard.RateLimitActivity.None")</p>
        }
        else
        {
            <p>@T("Admin.Dashboard.RateLimitActivity.Episodes", Model.EpisodeCount)</p>
            <p class="text-muted">@T("Admin.Dashboard.RateLimitActivity.Latest", Model.LatestOn) @Model.LatestShortMessage</p>
        }
    </div>
</div>
